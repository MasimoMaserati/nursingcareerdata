---
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} /><meta name="robots" content="index, follow" />
<link rel="canonical" href={canonical.href} /><meta name="theme-color" content="#102a43" />
<title>{title} | Nursing Career Data</title>
</head>
<body>
<header><a class="brand" href="/">Nursing Career Data</a><nav><a href="/nursing-salary/registered-nurse/">RN Salaries</a><a href="/methodology/">Methodology</a><a href="/about/">About</a></nav></header>
<slot />
<footer><p>© {new Date().getFullYear()} Nursing Career Data</p><nav><a href="/methodology/">Data methodology</a><a href="/contact/">Contact</a></nav></footer>
</body>
</html>
<style is:global>
:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;color:#142536;background:#f7f9fc}
*{box-sizing:border-box}body{margin:0;line-height:1.6}a{color:#145da0;text-decoration:none}a:hover{text-decoration:underline}
header,footer{max-width:1120px;margin:auto;padding:22px 24px;display:flex;align-items:center;justify-content:space-between;gap:20px}
header{border-bottom:1px solid #e1e8f0}.brand{color:#102a43;font-size:1.15rem;font-weight:800}
nav{display:flex;flex-wrap:wrap;gap:18px}footer{margin-top:60px;border-top:1px solid #e1e8f0;color:#526579;font-size:.92rem}
main{max-width:1120px;margin:auto;padding:54px 24px}.eyebrow{color:#2563a6;font-weight:700;text-transform:uppercase;letter-spacing:.09em;font-size:.78rem}
h1{max-width:820px;color:#102a43;font-size:clamp(2.2rem,5vw,4rem);line-height:1.08;letter-spacing:-.04em}h2{color:#102a43}
.lead{max-width:760px;color:#526579;font-size:1.18rem}.hero{padding:46px;border-radius:24px;background:linear-gradient(135deg,#e8f2fb,#f2f7fb);border:1px solid #dce8f2}
.button{display:inline-block;padding:12px 18px;border-radius:10px;background:#145da0;color:white;font-weight:700}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:18px;margin:28px 0}
.panel{background:white;border:1px solid #e1e8f0;border-radius:16px;padding:22px}.muted{color:#617589}
@media(max-width:650px){header,footer{align-items:flex-start;flex-direction:column}.hero{padding:28px}main{padding:32px 18px}}
</style>
