---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import wages from '../../../data/rn-state-wages.json';
import national from '../../../data/rn-national-wage.json';

const published = wages
  .filter((item) => item.annualMedianWage != null && item.referenceYear)
  .sort((a, b) => b.annualMedianWage - a.annualMedianWage);
const referenceYear = national.referenceYear ?? published[0]?.referenceYear ?? 2025;
const money = (value, digits = 0) => value == null ? '—' : new Intl.NumberFormat('en-US', {
  style: 'currency', currency: 'USD', minimumFractionDigits: digits, maximumFractionDigits: digits
}).format(value);
const number = (value) => value == null ? '—' : Math.round(value).toLocaleString('en-US');
const medianDifference = (item) => item.annualMedianWage == null || national.annualMedianWage == null
  ? null : item.annualMedianWage - national.annualMedianWage;
const medianDifferenceLabel = (item) => {
  const difference = medianDifference(item);
  if (difference == null) return '—';
  const sign = difference > 0 ? '+' : difference < 0 ? '−' : '';
  return sign + money(Math.abs(difference));
};
const topFive = published.slice(0, 5);
const faq = [
  {
    question: 'What is the national median salary for Registered Nurses?',
    answer: national.annualMedianWage == null
      ? 'The national BLS estimate is not available in this build.'
      : `The U.S. Bureau of Labor Statistics reports a national annual median wage of ${money(national.annualMedianWage)} for Registered Nurses for May ${referenceYear}.`
  },
  {
    question: 'How are states ranked on this page?',
    answer: 'States and the District of Columbia are ranked from highest to lowest by the BLS annual median wage estimate for Registered Nurses. Missing wage estimates are excluded rather than treated as zero.'
  },
  {
    question: 'Are national wages calculated by averaging state wages?',
    answer: 'No. The national figures shown here are imported independently from the BLS national Occupational Employment and Wage Statistics workbook. They are not calculated by averaging state values.'
  },
  {
    question: 'What is the difference between median and mean wages?',
    answer: 'Median wage is the 50th percentile of the wage distribution. Mean wage is the arithmetic average. The two measures describe different parts of the wage distribution and should not be used interchangeably.'
  }
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer }
  }))
};
---
<BaseLayout title={`Registered Nurse Salary by State (${referenceYear})`} description={`Compare official BLS May ${referenceYear} Registered Nurse salary estimates across all available U.S. states and the District of Columbia. View national annual and hourly wage distributions, state rankings, employment, and pay differences from the U.S. median.`}>
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<main>
  <p class="eyebrow">U.S. nursing salary data · BLS OEWS</p>
  <h1>Registered Nurse Salary by State</h1>
  <p class="lead">Compare Registered Nurse (SOC 29-1141) wages across the United States using official BLS Occupational Employment and Wage Statistics estimates for May {referenceYear}.</p>

  {published.length > 0 ? <>
    <section class="panel dataset-intro">
      <h2>U.S. Registered Nurse salary overview</h2>
      <p>National estimates below are taken directly from the BLS national workbook. They are not calculated by averaging state wages.</p>
      <div class="summary-grid">
        <article><span>U.S. annual median wage</span><strong>{money(national.annualMedianWage)}</strong><small>50th percentile</small></article>
        <article><span>U.S. annual mean wage</span><strong>{money(national.annualMeanWage)}</strong><small>Arithmetic average</small></article>
        <article><span>U.S. hourly mean wage</span><strong>{money(national.hourlyMeanWage, 2)}</strong><small>Average hourly wage</small></article>
        <article><span>U.S. hourly median wage</span><strong>{money(national.hourlyMedianWage, 2)}</strong><small>50th percentile</small></article>
        <article><span>U.S. RN employment</span><strong>{number(national.employment)}</strong><small>Estimated jobs</small></article>
      </div>
      <section class="national-distribution" aria-labelledby="national-distribution-title">
        <h3 id="national-distribution-title">U.S. wage distribution</h3>
        <p class="muted">Published BLS annual and hourly wage thresholds for Registered Nurses. The percentiles describe the wage distribution; they are not starting-pay or guaranteed salary ranges.</p>
        <div class="table-wrap">
          <table class="percentile-table">
            <thead><tr><th scope="col">Percentile</th><th scope="col">Annual wage</th><th scope="col">Hourly wage</th></tr></thead>
            <tbody>
              <tr><th scope="row">10th</th><td>{money(national.annual10thPercentile)}</td><td>{money(national.hourly10thPercentile, 2)}</td></tr>
              <tr><th scope="row">25th</th><td>{money(national.annual25thPercentile)}</td><td>{money(national.hourly25thPercentile, 2)}</td></tr>
              <tr><th scope="row">50th (median)</th><td><strong>{money(national.annualMedianWage)}</strong></td><td><strong>{money(national.hourlyMedianWage, 2)}</strong></td></tr>
              <tr><th scope="row">75th</th><td>{money(national.annual75thPercentile)}</td><td>{money(national.hourly75thPercentile, 2)}</td></tr>
              <tr><th scope="row">90th</th><td>{money(national.annual90thPercentile)}</td><td>{money(national.hourly90thPercentile, 2)}</td></tr>
            </tbody>
          </table>
        </div>
      </section>
      <p class="muted">Reference period: May {referenceYear}. Occupation: Registered Nurses (29-1141).</p>
    </section>

    <section>
      <h2>Highest-paying states for Registered Nurses</h2>
      <p class="muted">Top five jurisdictions ranked by annual median wage in the imported BLS state dataset.</p>
      <div class="top-grid">
        {topFive.map((item, index) => <article class="panel top-card">
          <span class="rank">#{index + 1}</span>
          <h3><a href={`/nursing-salary/registered-nurse/${item.stateSlug}/`}>{item.state}</a></h3>
          <strong>{money(item.annualMedianWage)}</strong>
          <span class="muted">Annual median wage</span>
        </article>)}
      </div>
    </section>

    <section>
      <h2>State salary comparison and ranking</h2>
      <p class="muted">Rank is based on annual median wage, highest to lowest. The difference column compares each jurisdiction's annual median with the independently published U.S. annual median of {money(national.annualMedianWage)}.</p>
      <div class="panel table-wrap">
        <table>
          <thead><tr><th scope="col">Rank</th><th scope="col">State / district</th><th scope="col">Annual median</th><th scope="col">Difference from U.S. annual median</th><th scope="col">Annual mean</th><th scope="col">Hourly mean</th><th scope="col">Employment</th></tr></thead>
          <tbody>
            {published.map((item, index) => <tr>
              <td>{index + 1}</td>
              <th scope="row"><a href={`/nursing-salary/registered-nurse/${item.stateSlug}/`}>{item.state}</a></th>
              <td><strong>{money(item.annualMedianWage)}</strong></td>
              <td class={medianDifference(item) != null && medianDifference(item) > 0 ? 'above' : medianDifference(item) != null && medianDifference(item) < 0 ? 'below' : ''}>{medianDifferenceLabel(item)}</td>
              <td>{money(item.annualMeanWage)}</td>
              <td>{money(item.hourlyMeanWage, 2)}</td>
              <td>{number(item.employment)}</td>
            </tr>)}
          </tbody>
        </table>
      </div>
    </section>

    <section class="panel">
      <h2>About this BLS dataset</h2>
      <p>Source: U.S. Bureau of Labor Statistics (BLS), Occupational Employment and Wage Statistics (OEWS).</p>
      <p>Reference period: May {referenceYear}. Occupation: Registered Nurses, SOC 29-1141.</p>
      <p>Showing {published.length} jurisdictions with a published state-level estimate, including the District of Columbia when available.</p>
      <p>Median wage is the midpoint of the wage distribution; mean wage is the arithmetic average. These measures are not interchangeable.</p>
      <p class="muted">OEWS employment estimates count jobs, not professional licenses or unique people. A missing value is not zero.</p>
      <p><a href="https://www.bls.gov/oes/tables.htm" rel="noopener noreferrer">Official BLS national estimates →</a> · <a href="https://www.bls.gov/oes/tables.htm" rel="noopener noreferrer">Official BLS state estimates →</a></p>
    </section>

    <section class="panel">
      <h2>Frequently asked questions</h2>
      {faq.map((item) => <details>
        <summary>{item.question}</summary>
        <p>{item.answer}</p>
      </details>)}
    </section>
  </> : <section class="panel"><h2>Official state data is not available in this build</h2><p class="muted">The BLS import runs before each production build. Check the deployment log for the data-import result; no placeholder salary values are displayed.</p><a href="/methodology/">Read our methodology →</a></section>}
  <section class="panel"><h2>Explore state salary profiles</h2><div class="link-grid">
    {published.map((item) => <a href={`/nursing-salary/registered-nurse/${item.stateSlug}/`}>{item.state} RN salary →</a>)}
  </div></section>
</main>
</BaseLayout>
<style>
.dataset-intro{margin:30px 0}
.summary-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:14px;margin:24px 0}
.summary-grid article{display:flex;flex-direction:column;gap:5px;padding:18px;border:1px solid #e1e8f0;border-radius:12px;background:#f8fbfe}
.summary-grid span,.summary-grid small{color:#617589}
.summary-grid strong{font-size:1.65rem;color:#102a43}
.top-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:14px;margin:22px 0}
.top-card{display:flex;flex-direction:column;gap:5px}
.top-card h3{margin:4px 0}
.top-card strong{font-size:1.35rem;color:#102a43}
.rank{font-size:.82rem;font-weight:800;color:#2563a6}
.table-wrap{overflow-x:auto}
table{width:100%;border-collapse:collapse;min-width:900px;font-size:.92rem}
th,td{padding:12px 13px;border-bottom:1px solid #e1e8f0;text-align:left;white-space:nowrap}
thead th{background:#f2f6fa;color:#334e68}
tbody tr:hover{background:#f7fafc}
.above{color:#137547;font-weight:700}.below{color:#8a4b15}
details{padding:15px 0;border-bottom:1px solid #e1e8f0}
details:last-child{border-bottom:0}
summary{cursor:pointer;font-weight:700;color:#102a43}
details p{color:#526579;margin-bottom:0}
.link-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:12px}
.national-distribution{margin-top:26px;padding-top:8px}
.national-distribution h3{margin-bottom:6px;color:#102a43}
.percentile-table{min-width:520px}
@media(max-width:650px){.summary-grid strong{font-size:1.35rem}}
</style>
